{
  "name": "booth-quiz-filter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test src/lib/*.test.ts worker/*.test.ts scheduler/*.test.ts scripts/*.test.mjs",
    "dev:worker": "wrangler dev --ip 127.0.0.1 --port 4175",
    "db:local": "wrangler d1 migrations apply booth-quiz-shares --local",
    "collect:booth": "node scripts/collect-all-booth.mjs",
    "collect:booth:probe": "node scripts/collect-booth.mjs",
    "collect:booth:three": "node scripts/probe-three-booth.mjs",
    "validate:catalog": "node scripts/validate-catalog.mjs",
    "check": "npm run test && npm run build",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "hono": "4.13.14",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261027.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "cheerio": "1.2.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "wrangler": "4.136.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.30.1",
      "sharp": "0.35.5"
    }
  }
}
